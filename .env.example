# Company Nexus offline MVP sample defaults
# Leave these unset to run in browser-local demo mode.
HUB_USERNAME=company@mail.com
HUB_PASSWORD=password

# Optional: connect to Firebase for shared team data and auth.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_AUTH_EMAIL=

# Optional: enable Gemini-powered AIRA chat.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_EMBEDDING_DIMENSIONS=768
# GEMINI_EMBEDDING_BATCH_SIZE=8
# GEMINI_EMBEDDING_MAX_RETRIES=4
# GEMINI_EMBEDDING_BATCH_DELAY_MS=1500

# Server-side backfill access. Use Application Default Credentials or a service account.
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_PROJECT_ID=

# Optional: legacy local login hint shown in the app.
# VITE_HUB_USERNAME=company
