rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /meta/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /tools/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /faqs/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /kbArticles/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /links/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /metrics/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /stockExchanges/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /companyApps/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /calendarEvents/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /teamMembers/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /contactTeams/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /knowledgeDocs/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /kanbanBoards/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /kanbanCards/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /reportTracker/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /productionTracker/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Agent write proposals — users may create/update their own pending proposals
    match /agentProposals/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Append-only style audit trail for agent confirm/reject decisions
    match /agentAudits/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
